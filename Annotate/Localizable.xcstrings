    "The default shortcut “%@” is already assigned. Clear it from the other action first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo por omisión “%@” ya está asignado. Quítalo primero de la otra acción."
          }
        },

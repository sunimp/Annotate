    "Clears the annotations on every open overlay. Clear can be undone in the overlay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra las anotaciones de todas las capas abiertas. El borrado se puede deshacer en la capa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les annotations de tous les calques ouverts. L’effacement peut être annulé dans le calque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているすべてのオーバーレイの注釈を消去します。消去はオーバーレイ上で取り消せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有已打开叠加层上的标注。可在叠加层中撤销清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有已開啟疊加層上的註解。可在疊加層中還原清除動作。"
          }
        }
      }
    },

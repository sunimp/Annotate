    "The image is on the clipboard, but Annotate couldn't save it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está en el portapapeles, pero Annotate no ha podido guardarla."
          }
        },
        "fr": {

    "Captures the display with its annotations as a PNG and passes it on. Also saves it, copies it, or both, as After Capture says in Annotate's Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura la pantalla con sus anotaciones como PNG y la pasa a la siguiente acción. También la guarda, la copia o ambas cosas, según Después de capturar en Ajustes de Annotate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture l’écran avec ses annotations au format PNG et la transmet. L’enregistre aussi, la copie ou les deux, selon le réglage Après la capture d’Annotate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを注釈ごとPNGとしてキャプチャし、次のアクションに渡します。Annotateの設定の“キャプチャ後”に従って、保存、コピー、またはその両方も行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将显示器连同标注截成 PNG 并传给下一步。同时按 Annotate 设置中的“截图后”存储、拷贝或两者都做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將顯示器連同標註擷取成 PNG 並傳給下一步。同時依 Annotate 設定中的「擷取後」儲存、拷貝或兩者都做。"
          }
        }
      }
    },

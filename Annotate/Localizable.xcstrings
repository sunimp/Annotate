    "Annotate couldn't finish the capture. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate no ha podido completar la captura. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate n’a pas pu terminer la capture. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateはキャプチャを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 未能完成截图，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 無法完成擷取。請稍後再試一次。"

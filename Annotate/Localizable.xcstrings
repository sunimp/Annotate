    "Undo the last action": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer la última acción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la dernière action"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の操作を取り消します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销上一步操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原上一個動作"
          }
        }
      }
    },
    "Use Solid for passwords and other secrets. Pixelate and Blur keep the rough shape of the content, which can sometimes be partly recovered.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Sólido para contraseñas y otros datos confidenciales. Pixelar y Desenfocar conservan la forma aproximada del contenido, que a veces puede recuperarse en parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Uni pour les mots de passe et autres secrets. Pixellisation et Flou conservent la forme approximative du contenu, qui peut parfois être en partie récupéré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードなどの機密情報には“塗りつぶし”を使用してください。“ピクセル化”と“ぼかし”は内容のおおまかな形が残るため、一部が復元される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遮盖密码等机密信息请使用“纯色”。“像素化”和“模糊”会保留内容的大致轮廓，有时可被部分还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼與其他機密資訊請使用「純色」。「像素化」和「模糊」會保留內容的大致形狀，有時可能被部分還原。"
          }
        }
      }
    },
    "Useful for virtual machines (such as UTM), games, and remote desktop clients that capture or lock the cursor.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil para máquinas virtuales (como UTM), juegos y clientes de escritorio remoto que capturan o bloquean el cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile pour les machines virtuelles (comme UTM), les jeux et les clients de bureau à distance qui capturent ou verrouillent le curseur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを捕捉またはロックする仮想マシン（UTMなど）、ゲーム、リモートデスクトップクライアントで便利です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于会捕获或锁定光标的虚拟机（如 UTM）、游戏和远程桌面客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於會擷取或鎖定游標的虛擬機器（例如 UTM）、遊戲與遠端桌面用戶端。"
          }
        }
      }
    },

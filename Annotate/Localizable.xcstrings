    "%@ Annotate also couldn't save the annotation data next to the image. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Annotate tampoco ha podido guardar los datos de anotación junto a la imagen. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Annotate n’a pas non plus pu enregistrer les données d’annotation à côté de l’image. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 画像の横に注釈データも保存できませんでした。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Annotate 也无法在图像旁存储标注数据。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Annotate 也無法在影像旁儲存標註資料。%@"
          }
        }
      }
    },

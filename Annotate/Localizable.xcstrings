          "stringUnit": {
            "state": "translated",
            "value": "キャプチャをデフォルトのフォルダに保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图已存储到默认文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取畫面已儲存至預設檔案夾"
          }
        }
      }
    },
    "Capture Screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer l’écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をキャプチャ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截取屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取螢幕"
          }
        }
      }
    },
    "Capture Screen takes a PNG of the display, and Capture Area of a part you drag out, with the board and annotations as they appear. It is copied to the clipboard, and no file is saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pantalla crea un PNG de la pantalla, y Capturar área de la parte que arrastres, con la pizarra y las anotaciones tal como se ven. Se copia al portapapeles y no se guarda ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer l’écran crée un PNG de l’écran, et Capturer une zone de la partie que vous délimitez, avec le tableau et les annotations tels qu’ils apparaissent. L’image est copiée dans le presse-papiers et aucun fichier n’est enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“画面をキャプチャ”はディスプレイ全体を、“範囲をキャプチャ”はドラッグした部分を、ボードと注釈を表示どおりに含めてPNGにします。画像はクリップボードにコピーされ、ファイルは保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“截取屏幕”会将整个显示器、“截取区域”会将你拖出的部分，连同画板和标注按显示效果截成 PNG。图像会拷贝到剪贴板，不存储文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擷取螢幕」會將整個顯示器、「擷取區域」會將你拖出的部分，連同畫板和標註依顯示效果擷取成 PNG。影像會拷貝到剪貼板，不儲存檔案。"
          }
        }
      }
    },
    "Capture Screen takes a PNG of the display, and Capture Area of a part you drag out, with the board and annotations as they appear. It is saved to this folder and copied to the clipboard.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pantalla crea un PNG de la pantalla, y Capturar área de la parte que arrastres, con la pizarra y las anotaciones tal como se ven. Se guarda en esta carpeta y se copia al portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer l’écran crée un PNG de l’écran, et Capturer une zone de la partie que vous délimitez, avec le tableau et les annotations tels qu’ils apparaissent. L’image est enregistrée dans ce dossier et copiée dans le presse-papiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“画面をキャプチャ”はディスプレイ全体を、“範囲をキャプチャ”はドラッグした部分を、ボードと注釈を表示どおりに含めてPNGにします。画像はこのフォルダに保存され、クリップボードにもコピーされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“截取屏幕”会将整个显示器、“截取区域”会将你拖出的部分，连同画板和标注按显示效果截成 PNG。图像会存储到此文件夹并拷贝到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擷取螢幕」會將整個顯示器、「擷取區域」會將你拖出的部分，連同畫板和標註依顯示效果擷取成 PNG。影像會儲存至此檔案夾並拷貝到剪貼板。"
          }
        }
      }
    },
    "Capture Screen takes a PNG of the display, and Capture Area of a part you drag out, with the board and annotations as they appear. It is saved to this folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pantalla crea un PNG de la pantalla, y Capturar área de la parte que arrastres, con la pizarra y las anotaciones tal como se ven. Se guarda en esta carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer l’écran crée un PNG de l’écran, et Capturer une zone de la partie que vous délimitez, avec le tableau et les annotations tels qu’ils apparaissent. L’image est enregistrée dans ce dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“画面をキャプチャ”はディスプレイ全体を、“範囲をキャプチャ”はドラッグした部分を、ボードと注釈を表示どおりに含めてPNGにします。画像はこのフォルダに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“截取屏幕”会将整个显示器、“截取区域”会将你拖出的部分，连同画板和标注按显示效果截成 PNG。图像会存储到此文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擷取螢幕」會將整個顯示器、「擷取區域」會將你拖出的部分，連同畫板和標註依顯示效果擷取成 PNG。影像會儲存至此檔案夾。"
          }
        }
      }
    },
    "Capture Screen, Capture Area, and the Redact tool's Pixelate and Blur styles read the pixels on screen. Until access is granted, capture works only while a fully opaque board is showing, and redactions use a solid fill. macOS may ask you to relaunch Annotate first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Capturar pantalla”, “Capturar área” y los estilos Pixelar y Desenfocar de la herramienta Ocultar leen los píxeles de la pantalla. Hasta que se conceda el acceso, la captura solo funciona con una pizarra totalmente opaca visible, y las ocultaciones usan un relleno sólido. Es posible que macOS te pida reabrir Annotate antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer l’écran, Capturer une zone et les styles Pixellisation et Flou de l’outil Masquer lisent les pixels à l’écran. Tant que l’accès n’est pas accordé, la capture ne fonctionne que si un tableau entièrement opaque est affiché, et les masques utilisent un remplissage uni. macOS peut vous demander de relancer Annotate au préalable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“画面をキャプチャ”、“範囲をキャプチャ”、および墨消しツールの“ピクセル化”と“ぼかし”スタイルは画面上のピクセルを読み取ります。アクセスが許可されるまでは、完全に不透明なボードを表示している間のみキャプチャでき、墨消しは塗りつぶしになります。macOSから先にAnnotateの再起動を求められる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“截取屏幕”“截取区域”以及遮盖工具的“像素化”和“模糊”样式需要读取屏幕像素。授权之前，仅在显示完全不透明的画板时才能截图，遮盖将使用纯色填充。macOS 可能会要求你先重新启动 Annotate。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擷取螢幕」、「擷取區域」，以及遮蔽工具的「像素化」和「模糊」樣式需要讀取螢幕上的像素。取得權限之前，只有在顯示完全不透明的畫板時才能擷取，遮蔽也會改用純色填滿。macOS 可能會要求你先重新啟動 Annotate。"
          }
        }
      }
    },

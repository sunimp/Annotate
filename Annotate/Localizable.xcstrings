    "Turns Fade mode on or off. With it off, annotations persist until cleared.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el modo Desvanecer. Si está desactivado, las anotaciones permanecen hasta que se borren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive le mode Estompage. Désactivé, les annotations restent jusqu’à leur effacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェードモードのオン/オフを切り替えます。オフの場合、注釈は消去するまで残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭淡出模式。关闭后，标注会保留直到被清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉淡出模式。關閉時，註解會保留直到清除。"
          }
        }
      }
    },

    "Colors on a number key use that number in the color picker. The rest fill the free numbers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores asignados a una tecla numérica usan ese número en el selector de color. El resto ocupa los números libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs associées à une touche numérique utilisent ce chiffre dans le sélecteur de couleur. Les autres prennent les chiffres libres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字キーに割り当てたカラーは、カラーピッカーでもその数字を使います。残りは空いている数字に入ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定到数字键的颜色在颜色选择器中使用该数字，其余颜色依次填入空闲的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定到數字鍵的顏色在顏色選擇器中使用該數字，其餘顏色依序填入空閒的數字。"
          }
        }
      }
    },

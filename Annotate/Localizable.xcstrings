    "The image was saved, but Annotate couldn't copy it to the clipboard. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen se ha guardado, pero Annotate no ha podido copiarla en el portapapeles. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image a été enregistrée, mais Annotate n’a pas pu la copier dans le presse-papiers. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージは保存されましたが、Annotateはクリップボードにコピーできませんでした。%@"

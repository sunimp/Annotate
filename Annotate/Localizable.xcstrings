    "The image is on the clipboard, but Annotate couldn't save it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está en el portapapeles, pero Annotate no ha podido guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image est dans le presse-papiers, mais Annotate n’a pas pu l’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージはクリップボードにありますが、Annotateは保存できませんでした。"
          }

    },
    "This folder can't be reached, so captures go to %@ until it comes back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a esta carpeta, así que las capturas irán a %@ hasta que vuelva a estar disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est inaccessible, les captures vont donc dans %@ jusqu’à son retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダにアクセスできないため、戻るまでキャプチャは%@に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问此文件夹，在恢复之前截图会存储到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取此檔案夾，在恢復之前擷取畫面會儲存至 %@。"
          }
        }
      }
    },

    "A circle filled with the selected color with a white number, or a black one on light colors.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un círculo relleno del color seleccionado con un número blanco, o negro sobre colores claros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cercle rempli de la couleur sélectionnée avec un numéro blanc, ou noir sur les couleurs claires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色で塗りつぶした円に白い数字を表示します（明るい色の場合は黒い数字）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以所选颜色填充的圆形，内含白色数字；浅色时数字为黑色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以所選顏色填滿的圓形，內含白色數字；淺色時改為黑色數字。"
          }
        }
      }
    },
    "A circle outlined in the selected color with the number in that color.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un círculo con contorno del color seleccionado y el número en ese color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cercle bordé de la couleur sélectionnée avec le numéro dans cette couleur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色の枠線で囲んだ円に、同じ色で数字を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以所选颜色描边的圆形，数字使用相同颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以所選顏色描邊的圓形，數字也使用該顏色。"
          }
        }
      }
    },

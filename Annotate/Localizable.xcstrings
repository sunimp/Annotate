    },
    "Annotate couldn't finish the capture. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate no ha podido completar la captura. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate n’a pas pu terminer la capture. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateはキャプチャを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 未能完成截图，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 無法完成擷取。請稍後再試一次。"
          }
        }
      }
    },
    "Annotate couldn't start Capture Area. If an area is already being picked, finish or cancel it first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate no ha podido iniciar Capturar área. Si ya se está eligiendo un área, termina o cancela primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate n’a pas pu lancer Capturer une zone. Si une zone est déjà en cours de sélection, terminez-la ou annulez-la d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateは“範囲をキャプチャ”を開始できませんでした。範囲を選択中の場合は、先に完了またはキャンセルしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 无法开始“截取区域”。如果正在选择区域，请先完成或取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 無法開始「擷取區域」。如果正在選擇區域，請先完成或取消。"
          }
        }
      }
    },
    "Annotate is still starting up. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate todavía se está iniciando. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate est encore en cours de démarrage. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateはまだ起動中です。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 仍在启动中，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 仍在啟動中。請稍後再試一次。"
          }
        }
      }
    },
    "Annotate needs Screen Recording permission to capture. Turn it on in Annotate's Settings, in the Capture pane.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate necesita permiso de grabación de pantalla para capturar. Actívalo en Ajustes de Annotate, en el panel Captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate a besoin de l’autorisation d’enregistrement de l’écran pour capturer. Activez-la dans les Réglages d’Annotate, dans la sous-fenêtre Capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャするには画面収録の許可が必要です。Annotateの設定の“キャプチャ”パネルでオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 需要屏幕录制权限才能截图。请在 Annotate 设置的“截图”面板中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 需要螢幕錄製權限才能擷取。請在 Annotate 設定的「擷取」面板中開啟。"
          }
        }
      }
    },

    "Annotate can't reach %@, so it saved %@ in %@. Choose another folder in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate no puede acceder a %@, así que ha guardado %@ en %@. Elige otra carpeta en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate ne peut pas accéder à %@ et a donc enregistré %@ dans %@. Choisissez un autre dossier dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateは“%@”にアクセスできないため、%@を%@に保存しました。設定で別のフォルダを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 无法访问“%@”，因此已将 %@ 存储到 %@。请在设置中选择其他文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 無法存取「%@」，因此已將 %@ 儲存至 %@。請在設定中選擇其他檔案夾。"
          }
        }
      }
    },
    "Annotate couldn't copy the capture to the clipboard. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate no ha podido copiar la captura al portapapeles. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate n’a pas pu copier la capture dans le presse-papiers. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotateはキャプチャをクリップボードにコピーできませんでした。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 无法将截图拷贝到剪贴板。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 無法將擷取畫面拷貝到剪貼板。%@"
          }
        }
      }
    },
    "Annotate couldn't deliver the image. %@": {
      "localizations": {

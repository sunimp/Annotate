    "Turn on background dimming whenever the spotlight is enabled": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar la atenuación del fondo siempre que el foco esté activado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l’assombrissement de l’arrière-plan dès que le projecteur est activé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポットライトが有効なときは常に背景を暗くします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

    "Sets the annotation color to a palette slot: 1 red, 2 orange, 3 yellow, 4 green, 5 cyan, 6 indigo, 7 magenta, 8 white, 9 black. Doesn't open the overlay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de anotación a una posición de la paleta: 1 rojo, 2 naranja, 3 amarillo, 4 verde, 5 cian, 6 índigo, 7 magenta, 8 blanco, 9 negro. No abre la capa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la couleur d’annotation sur un emplacement de la palette : 1 rouge, 2 orange, 3 jaune, 4 vert, 5 cyan, 6 indigo, 7 magenta, 8 blanc, 9 noir. N’ouvre pas le calque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注釈のカラーをパレットのスロットに設定します：1 赤、2 オレンジ、3 黄、4 緑、5 シアン、6 インディゴ、7 マゼンタ、8 白、9 黒。オーバーレイは開きません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标注颜色设为调色板槽位：1 红、2 橙、3 黄、4 绿、5 青、6 靛、7 品红、8 白、9 黑。不会打开叠加层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將標註顏色設為調色盤槽位：1 紅、2 橙、3 黃、4 綠、5 青、6 靛、7 洋紅、8 白、9 黑。不會打開疊加層。"
          }
        }
      }
    },

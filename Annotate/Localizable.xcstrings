    "Opens the annotation overlay on the display under the pointer, leaving Always-On mode.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la capa de anotación en la pantalla donde está el puntero y sale del modo Siempre activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le calque d’annotation sur l’écran sous le pointeur et quitte le mode Toujours actif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタがあるディスプレイで注釈オーバーレイを開き、常時表示モードを終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指针所在的显示器上打开标注叠加层，并退出常开模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指標所在的顯示器上打開註解覆蓋層，並離開永遠開啟模式。"
          }
        }
      }
    },
    "Opens the annotation overlay on the display under the pointer, or closes it if it's open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la capa de anotación en la pantalla donde está el puntero, o la cierra si ya está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le calque d’annotation sur l’écran sous le pointeur, ou le ferme s’il est ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタがあるディスプレイで注釈オーバーレイを開きます。すでに開いている場合は閉じます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指针所在的显示器上打开标注叠加层；若已打开则将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指標所在的顯示器上打開註解覆蓋層；若已打開則將其關閉。"
          }
        }
      }
    },
